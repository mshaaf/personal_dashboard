# ============================================
# PERSONAL DASHBOARD — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Supabase — Required
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Calendar — Optional
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Create: OAuth 2.0 Client ID (Web application)
# Authorized origins: http://localhost:5173 + your Vercel domain
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Books — no key needed. Book search uses the public Google Books API
# anonymously (fine for a single user), so there's no per-project daily quota.

# Strava — Optional (Activities page)
# Get from: strava.com/settings/api → create an application
# Set "Authorization Callback Domain" to your Vercel domain (no protocol/path)
# The Client ID is public and safe to ship in the frontend bundle:
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# ── Server-only (set these in Vercel → Project → Settings → Environment
# Variables, NOT here — they must never reach the browser):
#   STRAVA_CLIENT_ID           same numeric client id as above
#   STRAVA_CLIENT_SECRET       from strava.com/settings/api
#   SUPABASE_URL               same as VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  Supabase → Settings → API → service_role key
