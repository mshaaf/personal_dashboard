# ============================================
# PERSONAL DASHBOARD — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Supabase — Required
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Calendar — Optional
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Create: OAuth 2.0 Client ID (Web application)
# Authorized origins: http://localhost:5173 + your Vercel domain
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Books — Optional
# Book search works without a key, but a key avoids rate-limit (403) errors
# from shared hosting IPs. Get one at console.cloud.google.com → Books API.
VITE_GOOGLE_BOOKS_API_KEY=
